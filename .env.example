# Copy to .env.local and fill in. See spec/setup (team memory) for the full
# table, local-dev values and troubleshooting. Never commit real values.

# --- Database (Neon in prod/preview, local Postgres via docker-compose) ---
DATABASE_URL=postgresql://blog:blog_dev_password@localhost:5432/blog

# --- Auth.js v5 (Google + GitHub OAuth, single allow-listed author) ---
AUTH_SECRET=
# Local only — Vercel sets this automatically in preview/production.
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# provider:id pairs, e.g. google:109283746502938475,github:8341223 — the
# provider's immutable account id, never the GitHub username or an email.
AUTHOR_ALLOWLIST=

# --- Canonical site URL (SEO, sitemap, RSS, redirect targets) ---
SITE_URL=http://localhost:3000

# --- Object storage: Cloudflare R2 in prod/preview, MinIO locally ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=blog-media
R2_PUBLIC_BASE_URL=http://localhost:9000/blog-media
# Local only, points the S3 client at MinIO instead of R2. Never set in Vercel.
R2_ENDPOINT=http://localhost:9000

# --- Transactional email (contact form) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=author@example.com
CONTACT_FALLBACK_EMAIL=author@example.com

# --- Cloudflare Turnstile (contact form spam protection) ---
# Local: Cloudflare's published always-pass test keys. Never use these
# outside local dev.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Upstash Redis (sliding-window rate limiter) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Umami Cloud (cookie-free analytics) ---
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# --- Vercel Cron auth for the backup-export and trash-purge routes ---
CRON_SECRET=
